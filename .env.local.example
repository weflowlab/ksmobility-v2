# ─────────────────────────────────────────────────────────────
# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요.
# .env.local 은 git 에 올라가지 않습니다.
# 배포(Vercel 등) 시에는 아래 값들을 호스팅 환경변수에도 동일하게 넣어야 합니다.
# ─────────────────────────────────────────────────────────────

# Neon — 프로젝트 대시보드의 Connection string (Pooled 권장)
# 예: postgresql://neondb_owner:비밀번호@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
#
# ⚠ 이 값은 DB 전체 권한입니다. 서버에서만 씁니다.
#   - 절대 NEXT_PUBLIC_ 을 붙이지 마세요 (브라우저에 노출됩니다)
#   - 깃/슬랙/문서에 붙여넣지 마세요
#   - 유출 시 Neon 대시보드에서 비밀번호를 재발급(Reset password)하면 됩니다.
DATABASE_URL=

# 관리자 로그인 비밀번호 (/admin)
# 고객에게는 이 비밀번호만 알려주면 됩니다. Neon 계정·연결 문자열은 필요 없습니다.
# 미설정 시 로그인이 500 으로 막힙니다.
ADMIN_PASSWORD=

# (선택) 세션 서명 키. 미설정 시 ADMIN_PASSWORD 로 대체됩니다.
# 지정해 두면 비밀번호를 바꿔도 기존 로그인 세션이 유지됩니다.
# 임의의 긴 문자열 (예: openssl rand -hex 32)
ADMIN_SESSION_SECRET=
